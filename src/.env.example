# Chubu Commons AI environment template
# 使い方:
# 1. cp src/.env.example src/.env
# 2. [要設定] と書かれた項目だけ、自分の環境に合わせて埋める
# 3. [任意設定] は必要な時だけ変更する
# 4. [通常そのまま] は基本変更しない

# -------------------------------------------------------------------
# [要設定] 必須
# -------------------------------------------------------------------
API_KEY=AIzaから始まる実際のGemini APIキー

# -------------------------------------------------------------------
# [通常そのまま] Gemini
# -------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------------
# [通常そのまま] Search mode
# 現在の実装では knowledge_mode は常に search、
# search backend は常に hybrid に強制される
# -------------------------------------------------------------------
KNOWLEDGE_MODE_DEFAULT=search
SEARCH_BACKEND_DEFAULT=hybrid

# -------------------------------------------------------------------
# [任意設定] Frontend behavior
# -------------------------------------------------------------------
HOME_RETURN_SECONDS=30
CHAT_HISTORY_MAX_EXCHANGES=5
CHAT_HISTORY_WINDOW_MINUTES=2

# -------------------------------------------------------------------
# [通常そのまま] Chat log on/off
# -------------------------------------------------------------------
CHAT_LOG_ENABLED=true

# -------------------------------------------------------------------
# [通常そのまま] Hybrid search database
# Docker Compose の標準構成ではこのローカル PostgreSQL を使う
# 新しいサーバーでも Docker Compose 標準構成なら通常このままでよい
# -------------------------------------------------------------------
POSTGRES_DSN=postgresql://chu_ai:chu_ai@postgres:5432/chu_ai
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# -------------------------------------------------------------------
# [要設定] chat_logs 閲覧APIの秘密キー
# 公開リポジトリに載せない
# 長いランダム文字列に置き換える
# -------------------------------------------------------------------
CHAT_LOG_ADMIN_API_KEY=change-this-admin-key

# -------------------------------------------------------------------
# [任意設定] chat_logs の保存先
# 空なら POSTGRES_DSN をそのまま使う
# chat_logs を Supabase に保存したい時だけ設定する
# Supabase を使う場合の例:
# CHAT_LOG_POSTGRES_DSN=postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# -------------------------------------------------------------------
CHAT_LOG_POSTGRES_DSN=

# -------------------------------------------------------------------
# [任意設定] 管理APIの取得件数
# -------------------------------------------------------------------
CHAT_LOG_LIST_DEFAULT_LIMIT=50
CHAT_LOG_LIST_MAX_LIMIT=200

# -------------------------------------------------------------------
# [通常そのまま] Hybrid search indexing
# -------------------------------------------------------------------
HYBRID_AUTO_INIT_DB=true
HYBRID_EMBEDDING_MODEL=gemini-embedding-001
HYBRID_EMBEDDING_DIM=768
HYBRID_CHUNK_SIZE=500
HYBRID_CHUNK_OVERLAP=80
HYBRID_KEYWORD_TOP_K=20
HYBRID_VECTOR_TOP_K=20
HYBRID_FINAL_TOP_K=6
HYBRID_RRF_K=60
